# Rendered by the nginx image at startup: ${PORT}, ${BACKEND_URL} and ${NGINX_LOCAL_RESOLVERS}
# are filled in from the environment, nginx's own $variables stay as they are.

# Railway's edge terminates TLS and sends X-Forwarded-Proto; pass it on (or our own scheme locally)
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${PORT};
    listen [::]:${PORT};

    root /usr/share/nginx/html;

    # Railway's private DNS (from /etc/resolv.conf). With a variable in proxy_pass, nginx resolves the
    # backend per request, so it starts without the backend and follows it across redeploys.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
    set $backend ${BACKEND_URL};

    # /api/auth/me -> ${BACKEND_URL}/auth/me. Same origin for the browser, so the SameSite=Lax cookie is sent.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # creating a recipe waits for Gemini
        proxy_read_timeout 60s;
    }

    # Vite puts a content hash in these file names
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # client-side routes (/recipes, /verify-email?token=…) all get the SPA
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
